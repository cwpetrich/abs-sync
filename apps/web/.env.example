# Copy this to .env — `cp .env.example .env`. One file serves both ways of
# running abs-sync: from a checkout, where Next loads it automatically, and under
# Docker, where docker-compose.yml reads it as the container's environment.
#
# Two entries below cannot be shared, because they name paths that mean different
# things on either side of a container boundary. Compose overrides both; each is
# marked where it appears. Everything else applies to both, and most of it is
# also editable live on the Settings page, which wins over anything set here.

# SQLite database location. A file path relative to apps/web, or an absolute path.
# Ignored under Docker: the database belongs on the mounted volume, so Compose
# pins it to file:/data/abs-sync.db. Change where /data is mounted, not this.
DATABASE_URL="file:./dev.db"

# REQUIRED. Encrypts Audiobookshelf credentials at rest (min 32 chars).
# Generate with: openssl rand -base64 48
# Changing this invalidates every stored credential — you will have to re-enter them.
ABS_SYNC_SECRET=""

# Where downloads are spooled to disk before being uploaded to your server.
# Needs free space for the largest item you intend to sync.
# Where downloads land before upload, and are retained so a retry need not
# re-fetch them. Defaults to `spool/` beside the app. Avoid /tmp: it is cleared
# on reboot on most Linux systems, which would discard the retained downloads.
# Ignored under Docker for the same reason as DATABASE_URL — Compose pins it to
# /data/spool, on the volume.
# ABS_SYNC_SPOOL_DIR="/var/lib/abs-sync/spool"

# How many book transfers run at once.
# ABS_SYNC_MAX_CONCURRENT="2"

# How often watched series are re-checked, in minutes.
# ABS_SYNC_WATCH_INTERVAL_MINUTES="60"

# Refuse to transfer any single item larger than this (default 25 GB).
# Written as a size — "25 GB", "500 MB", "1.5 TB" — or a bare number of bytes.
# ABS_SYNC_MAX_ITEM_BYTES="25 GB"

# Downloaded audio kept on disk for transfers that have not succeeded yet, so a
# retry does not fetch the whole audiobook again. Longest-idle failed transfer is
# evicted first. Default 20 GB; set to 0 to keep nothing.
# ABS_SYNC_SPOOL_KEEP_BYTES="20 GB"

# Reject plain-http server URLs other than localhost.
# ABS_SYNC_REQUIRE_HTTPS="false"

# Hostnames this app is reached by besides localhost (LAN IP, machine name, or
# reverse-proxy host). Needed so Next allows dev assets and Server Actions from them.
# Set this if you reach the app at anything but http://localhost:3000 — which is
# most Docker installs. The whole UI is Server Actions, and the symptom of a
# missing entry is a page that renders perfectly and whose every button does
# nothing. Read at boot, so it needs a restart rather than taking effect live.
# ABS_SYNC_ALLOWED_ORIGINS="10.0.0.5,myhost.local"

# How often a full index reconcile is forced (hours). Incremental indexing
# cannot detect books deleted upstream; a full pass reconciles them.
# ABS_SYNC_FULL_REINDEX_HOURS="24"

# ---------------------------------------------------------------- notifications
# Both transports are optional and independent. With neither set, nothing is
# sent and nothing errors — the activity log is still written either way.

# Mattermost, either of two ways. The API is used when a token is set.
#
# 1. REST API with a bot or personal access token. Configured by channel name,
#    works when the server has incoming webhooks disabled, and one token can
#    serve several channels. The account the token belongs to must be a MEMBER
#    of the channel — adding a bot to a team does not add it to channels.
#    Team and channel are the two path segments of the channel's URL:
#    https://mattermost.example.com/<team>/channels/<channel>
# ABS_SYNC_MATTERMOST_URL="https://mattermost.example.com"
# ABS_SYNC_MATTERMOST_TOKEN=""
# ABS_SYNC_MATTERMOST_TEAM="audiobooks"
# ABS_SYNC_MATTERMOST_CHANNEL="general"
#
# 2. Incoming webhook, under Integrations → Incoming Webhooks. No token to
#    manage, and least privilege: a leaked webhook URL can only post to its own
#    channel, where a leaked token can act as its whole account.
#    ABS_SYNC_MATTERMOST_CHANNEL optionally overrides the webhook's channel.
# ABS_SYNC_MATTERMOST_WEBHOOK_URL="https://mattermost.example.com/hooks/xxxxxxxx"

# Browser push. Generate a keypair with: npm run notify:keys
# Changing these unsubscribes every device that had notifications enabled.
# Browser push additionally needs the app served over HTTPS — the Push API is
# refused on a plain-http origin, localhost aside.
# ABS_SYNC_VAPID_PUBLIC_KEY=""
# ABS_SYNC_VAPID_PRIVATE_KEY=""
# How the push services reach you about a misbehaving server.
# ABS_SYNC_VAPID_SUBJECT="mailto:you@example.com"

# Absolute URL this app is reached at, used for links inside notifications.
# A notification that opens a hostname only the server can resolve is useless
# on a phone, so links are omitted entirely when this is unset.
# ABS_SYNC_PUBLIC_URL="https://abs-sync.example.com"

# Seconds of routine activity batched into a single message. Failures ignore
# this and send immediately.
# ABS_SYNC_NOTIFY_DIGEST_SECONDS="30"
