# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and we do opt in: .env.example is the one template both the from-source and
# the Docker setup are built from, and the README tells you to copy it. Without
# this negation the blanket .env* above quietly kept it out of every clone.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# abs-sync
.env
*.db
*.db-journal
*.db-wal
*.db-shm
generated/
spool/
test-*.db
test-*.db-*
