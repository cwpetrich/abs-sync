# Agent tooling scaffolding written by `prisma init` (duplicated four ways).
# The .claude/skills entries are symlinks into .agents/, so committing them
# would hand anyone who clones a directory of dangling links.
.agents/
.windsurf/
**/.agents/
**/.windsurf/
skills-lock.json
**/skills-lock.json
**/.claude/skills/

# Per-machine Claude Code permissions, full of absolute paths from one box.
# The glob also covers the .tmp.* files it writes alongside, which otherwise
# race with `git add` and abort the commit when they vanish mid-stage.
.claude/settings.local.json*
**/.claude/settings.local.json*

# pm2 logs
logs/

# snapcraft build artifacts. `snapcraft` writes these into the project root, and
# parts/ alone is a few hundred MB of unpacked Node and node_modules.
/parts/
/stage/
/prime/
*.snap
